            "description": "O visitante vê em segundos (o widget busca as novidades). Abra o chat do site e mande uma mensagem antes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversation_id\": \"{{widget_conversation_id}}\",\n  \"type\": \"text\",\n  \"text\": \"Oi! Aqui é o sistema integrado.\",\n  \"agent_name\": \"Ana\"\n}",
